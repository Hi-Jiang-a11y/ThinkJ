XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_DOCUMENTS_DIR="$HOME/Docs"
XDG_PROJECTS_DIR="$HOME/playground"

XDG_DESKTOP_DIR="$HOME/.local/share/user-dirs/Desktop"
XDG_MUSIC_DIR="$HOME/.local/share/user-dirs/Music"
XDG_PICTURES_DIR="$HOME/.local/share/user-dirs/Pictures"
XDG_PUBLICSHARE_DIR="$HOME/.local/share/user-dirs/Public"
XDG_TEMPLATES_DIR="$HOME/.local/share/user-dirs/Templates"
XDG_VIDEOS_DIR="$HOME/.local/share/user-dirs/Videos"
