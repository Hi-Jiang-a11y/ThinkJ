[Desktop Entry]
Type=Application
Name=Neovim in Kitty
Comment=Edit text files with Neovim in Kitty
TryExec=kitty
Exec=kitty --class nvim -e nvim %F
Icon=nvim
Terminal=false
NoDisplay=true
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;application/json;application/x-yaml;text/x-cmake;text/x-tex;application/x-zerosize;
