# Dark notification cards for Niri: black, pink, and soft violet accents.

[global]
    follow = mouse

    width = (0, 380)
    height = (0, 180)
    origin = top-right
    offset = (16, 10)
    scale = 0
    notification_limit = 4

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 340
    progress_bar_corner_radius = 4
    progress_bar_corners = all

    indicate_hidden = yes
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#ffb6c1"
    gap_size = 10
    sort = update

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_corner_radius = 8
    icon_corners = all

    sticky_history = yes
    history_length = 50

    dmenu = /usr/bin/fuzzel --dmenu --prompt dunst:
    browser = /usr/bin/xdg-open
    always_run_script = false

    corner_radius = 12
    corners = all
    force_xwayland = false

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = false
    enable_pcre_regex = false

[urgency_low]
    background = "#17141d"
    foreground = "#b9b2c4"
    frame_color = "#6f647c"
    highlight = "#6f647c"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#191919"
    foreground = "#fff0f5"
    frame_color = "#ffb6c1"
    highlight = "#ff87c0"
    timeout = 8
    override_pause_level = 30
    default_icon = dialog-information

[urgency_critical]
    background = "#2b151e"
    foreground = "#fff0f5"
    frame_color = "#f53c6b"
    highlight = "#f53c6b"
    timeout = 12
    override_pause_level = 60
    default_icon = dialog-warning

[fullscreen_delay]
    fullscreen = delay

[fullscreen_show_critical]
    msg_urgency = critical
    fullscreen = show
