// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "autohide": "false",
    "autohide-blocked": "false",
    "exclusive": "true",
    "passthrough": "false",
    "height": 28,
    "spacing": 0, // Gaps between modules
    // Choose the order of the modules
    "modules-left": [
        "niri/workspaces",
        "clock",
        "cpu",
        "memory",
        "disk",
        "temperature"
    ],
    "modules-center": [
        "custom/window-or-media"
    ],
    "modules-right": [
        "idle_inhibitor",
        "custom/updates",
        "custom/clipboard",
        "backlight",
        "pulseaudio",
        "network",
        "battery",
        "group/tray"
    ],

    "niri/workspaces": {
        "current-only": false,
        "format": "[{index}]"
    },
    "niri/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "niri/window": {
        "format": "[ {} ]",
        "max-length": 56,
        "separate-outputs": false
    },
    "custom/window-or-media": {
        "format": "[ {text} ]",
        "max-length": 56,
        "hide-empty-text": true,
        "exec": "if [ \"$(playerctl status 2>/dev/null)\" = Playing ]; then playerctl metadata --format ' {{artist}} — {{title}}'; else niri msg --json focused-window 2>/dev/null | sed -n 's/.*\"title\":\"\\([^\"]*\\)\".*/\\1/p'; fi",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 1,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "tray": {
        "spacing": 4
        // "icons": {
        //   "blueman": "bluetooth",
        //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        // }
    },
    "custom/tray-toggle": {
        "format": "[]",
        "tooltip": false
    },
    "group/tray": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 200,
            "children-class": "tray-hidden",
            "click-to-reveal": true,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/tray-toggle",
            "tray"
        ]
    },
    "clock": {
        "format": "[{:%H:%M|%m/%d}]",
        "format-alt": "[ {:%a %d %b} ]",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "kitty --class calcurse -e calcurse"
    },
    "cpu": {
        "interval": 30,
        "format": "[CPU {usage}%]",
        "tooltip": false,
        "on-click": "kitty --class btop -e btop"
    },
    "memory": {
        "interval": 30,
        "format": "[MEM {used:0.1f}G]",
        "tooltip": false,
        "on-click": "kitty --class btop -e btop"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 65,
        "format": "[ {temperatureC}°C]",
        "on-click": "kitty --class btop -e btop"
    },
    "disk": {
        "interval": 60,
        "path": "/home",
        "format": "[HOME {percentage_used}%]",
        "tooltip-format": "{used} used of {total} ({percentage_used}%)",
        "on-click": "kitty --class btop -e btop"
    },
    "backlight": {
        "format": "[{icon} {percent}%]",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false,
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "[{capacity}% {icon} ]",
        "format-full": "[{capacity}% {icon} ]",
        "format-charging": "[{capacity}%  ]",
        "format-plugged": "[{capacity}%  ]",
        "format-alt": "[{time} {icon} ]",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "[  {signalStrength}%]",
        "format-ethernet": "[󰈀]",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "[󰈀]",
        "format-disconnected": "[󰖪]",
        "format-alt": "[{ifname}: {ipaddr}/{cidr}]",
        "on-click": "nm-connection-editor",
        "on-click-right": "kitty --class nmtui -e nmtui"
    },
    "pulseaudio": {
        "scroll-step": 2,
        "format": "[{volume}% {icon}]",
        "format-bluetooth": "[{volume}% {icon}]",
        "format-bluetooth-muted": "[󰝟 {icon}]",
        "format-muted": "[󰝟]",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        }
    },
    "idle_inhibitor": {
        "format": "[{icon} ]",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip-format-activated": "Idle inhibit: on",
        "tooltip-format-deactivated": "Idle inhibit: off"
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 14,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true,
                "tooltip-icon-size": 20
            },
            {
                "type": "audio-in",
                "tooltip": true,
                "tooltip-icon-size": 20
            }
        ]
    },
    "custom/updates": {
        "format": "[UPD {text}]",
        "exec": "checkupdates 2>/dev/null | wc -l",
        "interval": 1800,
        "tooltip": true,
        "tooltip-format": "{text} pending pacman updates\nLeft click: run system update",
        "on-click": "kitty --class system-update -e bash -lc 'sudo pacman -Syu; exec bash'"
    },
    "custom/clipboard": {
        "format": "[CLIP {text}]",
        "exec": "cliphist list 2>/dev/null | wc -l",
        "signal": 8,
        "tooltip": true,
        "tooltip-format": "Clipboard history: {text} entries\nLeft click: pick and copy\nRight click: clear",
        "on-click": "selection=$(cliphist list | fuzzel --dmenu --with-nth=2 --no-run-if-empty --prompt='Clipboard> '); [ -n \"$selection\" ] && printf '%s' \"$selection\" | cliphist decode | wl-copy",
        "on-click-right": "cliphist wipe"
    },
    "custom/media": {
        "format": "[ {text} ]",
        "max-length": 28,
        "hide-empty-text": true,
        "exec": "playerctl metadata --format ' {{artist}} — {{title}}' 2> /dev/null || true",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    }
}
