# Vim/lf-style navigation and practical playback controls
def_key "j"
  scroll_down
def_key "k"
  scroll_up
def_key "h"
  previous_column
def_key "l"
  next_column
def_key "ctrl-j"
  scroll_down
def_key "ctrl-k"
  scroll_up
def_key "ctrl-h"
  previous_column
def_key "ctrl-l"
  next_column
def_key "g"
  move_home
def_key "G"
  move_end
def_key "J"
  move_selected_items_down
def_key "K"
  move_selected_items_up
def_key "ctrl-b"
  page_up
def_key "ctrl-u"
  page_up
def_key "ctrl-f"
  page_down
def_key "ctrl-d"
  page_down

# Screen navigation
def_key "tab"
  next_screen
def_key "shift-tab"
  previous_screen
def_key "1"
  show_playlist
def_key "2"
  show_browser
def_key "3"
  show_search_engine
def_key "4"
  show_media_library
def_key "8"
  show_visualizer
def_key "q"
  require_screen "selected_items_adder"
  previous_screen
def_key "q"
  quit

# Playback
def_key "enter"
  require_screen "browser"
  enter_directory
def_key "enter"
  require_screen "selected_items_adder"
  enter_directory
def_key "enter"
  play_item
def_key "space"
  pause
def_key "x"
  stop
def_key "n"
  next
def_key "p"
  previous
def_key ">"
  next
def_key "<"
  previous
def_key "z"
  toggle_random
def_key "r"
  toggle_repeat
def_key "y"
  toggle_single
def_key "+"
  volume_up
def_key "-"
  volume_down

# lf-like file/list actions
def_key "a"
  add_item_to_playlist
def_key "A"
  add_selected_items
def_key "d"
  delete_playlist_items
def_key "c"
  clear_playlist
def_key "u"
  update_database
def_key "backspace"
  jump_to_parent_directory
def_key "o"
  jump_to_playing_song

# Search and selection
def_key "/"
  find
def_key "?"
  find
def_key "."
  next_found_item
def_key ","
  previous_found_item
def_key "v"
  select_item
def_key "V"
  select_range
def_key "i"
  show_song_info
