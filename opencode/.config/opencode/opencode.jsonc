{
  "$schema": "https://opencode.ai/config.json",

  "model": "anthropic/claude-sonnet-4-5",

  "small_model": "google/gemini-2.5-flash",

  "default_agent": "plan",

  "permission": {
    "read": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": "ask"
  },

  "tools": {
    "write": true,
    "edit": true,
    "bash": true
  },

  "instructions": [
    ".opencode/RULES.md"
  ],

  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**"
    ]
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "agent": {
    "embedded": {
      "description": "STM32 expert",
      "model": "anthropic/claude-sonnet-4-5",
      "prompt": "Prefer STM32 SPL instead of HAL. Separate .c and .h files."
    },

    "linux": {
      "description": "Linux expert",
      "model": "anthropic/claude-sonnet-4-5",
      "prompt": "Focus on Arch Linux, systemd, networking and kernel."
    },

    "reviewer": {
      "description": "Read-only code review",
      "model": "anthropic/claude-sonnet-4-5",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}
