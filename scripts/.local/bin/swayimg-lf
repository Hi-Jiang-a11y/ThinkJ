#!/usr/bin/env bash

file="$1"

if [ -z "$file" ]; then
    exit 1
fi

dir="$(dirname "$file")"

tmp=$(mktemp)

{
    printf '%s\n' "$file"

    find "$dir" -maxdepth 1 -type f \
        \( \
        -iname '*.png'  -o \
        -iname '*.jpg'  -o \
        -iname '*.jpeg' -o \
        -iname '*.webp' \
        \) \
        ! -path "$file" \
        | sort
} > "$tmp"

swayimg --appid="temp-swayimg" -f "$tmp"

rm "$tmp"
