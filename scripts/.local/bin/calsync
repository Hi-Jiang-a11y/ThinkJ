#!/bin/bash

REMOTE_USER="Juliet"
REMOTE_IP="10.16.181.132"
LOCAL_DIR="$HOME/.local/share/calcurse"
REMOTE_DIR="$HOME/.local/share/calcurse"

if ! ping -c 1 -W 1 "$REMOTE_IP" > /dev/null; then
    echo "Error: Cannot connect to $REMOTE_IP"
    exit 1
fi

case $1 in
    push)
        echo "Pushing calcurse to $REMOTE_IP..."
        rsync -avzu --delete "$LOCAL_DIR/" "${REMOTE_USER}@${REMOTE_IP}:${REMOTE_DIR}/"
        ;;
    pull)
        echo "Pulling calcurse from $REMOTE_IP..."
        rsync -avzu --delete "${REMOTE_USER}@${REMOTE_IP}:${REMOTE_DIR}/" "$LOCAL_DIR/"
        ;;
    *)
        echo "Usage: csync [push|pull]"
        echo "  push: local  -> remote"
        echo "  pull: remote -> local"
        exit 1
        ;;
esac

echo "Done"
