#!/usr/bin/env python3
#Map one, two, or three Play/Pause presses to media actions pause/play, next, previous.#

import asyncio
import fcntl
import os
from pathlib import Path
import socket
import subprocess
import sys
import time

DELAY = 0.3
MIN_PRESS_INTERVAL = 0.12
POST_ACTION_GUARD = 0.25
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/user-{os.getuid()}"))
SOCKET_PATH = RUNTIME_DIR / "media-key-double-tap.sock"
LOCK_PATH = RUNTIME_DIR / "media-key-double-tap.lock"


async def playerctl(action: str) -> None:
    process = await asyncio.create_subprocess_exec(
        "playerctl",
        "--player=spotify,mpv",
        action,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    await process.wait()


async def serve() -> None:
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    lock_file = LOCK_PATH.open("w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    try:
        SOCKET_PATH.unlink()
    except FileNotFoundError:
        pass

    loop = asyncio.get_running_loop()
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    sock.setblocking(False)
    sock.bind(str(SOCKET_PATH))
    pending = None
    click_count = 0
    last_press_at = 0.0
    ignore_until = 0.0

    def resolve_clicks() -> None:
        nonlocal pending, click_count, ignore_until
        actions = {1: "play-pause", 2: "next", 3: "previous"}
        action = actions.get(click_count)
        pending = None
        click_count = 0
        ignore_until = loop.time() + POST_ACTION_GUARD
        if action is not None:
            loop.create_task(playerctl(action))

    try:
        while True:
            await loop.sock_recv(sock, 1)
            now = loop.time()
            if now < ignore_until:
                continue
            if click_count and now - last_press_at < MIN_PRESS_INTERVAL:
                continue
            last_press_at = now
            click_count += 1
            if pending is not None:
                pending.cancel()
            if click_count == 3:
                resolve_clicks()
            else:
                pending = loop.call_later(DELAY, resolve_clicks)
    finally:
        sock.close()
        SOCKET_PATH.unlink(missing_ok=True)


def send_press() -> bool:
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        sock.sendto(b"p", str(SOCKET_PATH))
        return True
    except (FileNotFoundError, ConnectionRefusedError):
        return False
    finally:
        sock.close()


def start_daemon() -> None:
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "--daemon"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--daemon":
        asyncio.run(serve())
    elif not send_press():
        start_daemon()
        for _ in range(20):
            time.sleep(0.01)
            if send_press():
                break
